{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/convert.py": { "includeFiles": "{converter,webauth}/**", "maxDuration": 60 },
    "api/me.py": { "includeFiles": "webauth/**" },
    "api/checkout.py": { "includeFiles": "webauth/**" },
    "api/portal.py": { "includeFiles": "webauth/**" },
    "api/webhook.py": { "includeFiles": "webauth/**" },
    "api/prices.py": { "includeFiles": "webauth/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; img-src 'self' data: blob:; media-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-9yKKDWaOkqIEd6PqyiK8F1J48/8k43Q/lsxIWMli36Q='; connect-src 'self' https://zpowmnhdsybaicvlkkwx.supabase.co wss://zpowmnhdsybaicvlkkwx.supabase.co; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "redirects": [
    { "source": "/webauth/:p*", "destination": "/", "permanent": false },
    { "source": "/converter/:p*", "destination": "/", "permanent": false }
  ]
}
