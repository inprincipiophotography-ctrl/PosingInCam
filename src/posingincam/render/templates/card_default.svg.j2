{# Side-by-side layout matching Cue: illustration left, info right.
   Reference space: 4000 wide × (4000 * height/width) tall.
   Left half (0..2000): vertical brand watermark + centered illustration.
   Right half (2000..4000): pack badge, page #, big title, subtitle,
   2x2 panel grid (HER/HIM, LENS/ANGLE), blue SAY hero, optional
   orange TIP, version stamp. #}
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}">
  <defs>
    <style>
      .bg          { fill: #0E1420; }
      .panel-bg    { fill: #1A2330; }
      .panel-cue   { fill: #1E3A5F; }
      .panel-tip   { fill: #5A2E1A; }
      .ink         { fill: #FFFFFF; }
      .muted       { fill: #A8B0BD; }
      .label-gold  { fill: #E0A93E; }
      .label-blue  { fill: #7DB3E8; }
      .label-orange{ fill: #E8A040; }
      .divider     { fill: none; stroke: #2A3540; stroke-width: 3; }

      .pack-badge  { font-family: 'Helvetica','Arial',sans-serif; font-weight: 800; font-size: {{ s(48) }}px; letter-spacing: 8px; }
      .page-num    { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(48) }}px; }
      .h1          { font-family: 'Helvetica','Arial',sans-serif; font-weight: 800; font-size: {{ s(220) }}px; }
      .subtitle    { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(70) }}px; }
      .label       { font-family: 'Helvetica','Arial',sans-serif; font-weight: 800; font-size: {{ s(56) }}px; letter-spacing: 6px; }
      .body        { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(60) }}px; }
      .body-sm     { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(48) }}px; }
      .cue         { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(78) }}px; }
      .footer      { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(40) }}px; }
      .watermark   { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(36) }}px; letter-spacing: 4px; }
    </style>
  </defs>

  <rect class="bg" width="100%" height="100%"/>

  {# ===== LEFT HALF — illustration zone + brand watermark ===== #}

  {# Vertical watermark on far-left edge (rotated 270deg so it reads bottom-to-top) #}
  <text class="watermark muted" transform="translate({{ s(60) }}, {{ height - s(80) }}) rotate(-90)">
    posingincam.com  ·  {{ pose.id|upper }}
  </text>

  {# Illustration centered in the left half, white via currentColor #}
  <g transform="translate({{ s(180) }}, {{ s(100) }})" color="#FFFFFF">
    <svg width="{{ s(1700) }}" height="{{ height - s(200) }}" viewBox="{{ illustration_viewbox }}" preserveAspectRatio="xMidYMid meet">
      {{ illustration_svg|safe }}
    </svg>
  </g>

  {# ===== RIGHT HALF — info ===== #}

  {% set rx = 2120 %}
  {% set rw = 4000 - rx - 80 %}

  {# Pack badge top-left of right column, page indicator top-right #}
  <g transform="translate({{ s(rx) }}, {{ s(120) }})">
    <rect class="panel-tip" x="-{{ s(20) }}" y="-{{ s(60) }}" width="{{ s(48 * (pose.pack|length + 4) + 20) }}" height="{{ s(80) }}" rx="{{ s(8) }}"/>
    <text class="pack-badge label-gold">{{ pose.pack|upper }}</text>
  </g>
  <text class="page-num muted" x="{{ width - s(80) }}" y="{{ s(120) }}" text-anchor="end">{{ pose.id|upper }}</text>

  {# Big title #}
  <text class="h1 ink" x="{{ s(rx) }}" y="{{ s(420) }}">{{ pose.title }}</text>

  {# Subtitle: tags or first part of cue #}
  {% if pose.tags %}
  <text class="subtitle muted" x="{{ s(rx) }}" y="{{ s(540) }}">{{ pose.tags[:3]|join(' · ') }}</text>
  {% endif %}

  <line class="divider" x1="{{ s(rx) }}" y1="{{ s(620) }}" x2="{{ width - s(80) }}" y2="{{ s(620) }}"/>

  {# 2x2 grid of small info panels #}
  {% set p_top = 680 %}
  {% set p_h = 380 %}
  {% set p_gap = 30 %}
  {% set p_w = (rw - p_gap) / 2 %}

  {# Row 1: HER | HIM #}
  <g transform="translate({{ s(rx) }}, {{ s(p_top) }})">
    <rect class="panel-bg" width="{{ s(p_w) }}" height="{{ s(p_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(80) }}">HER</text>
    {% for line in pose.positioning.her[:2] %}
    <text class="body-sm ink" x="{{ s(40) }}" y="{{ s(160 + loop.index0 * 70) }}">{{ line }}</text>
    {% endfor %}
  </g>
  <g transform="translate({{ s(rx + p_w + p_gap) }}, {{ s(p_top) }})">
    <rect class="panel-bg" width="{{ s(p_w) }}" height="{{ s(p_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(80) }}">HIM</text>
    {% for line in pose.positioning.him[:2] %}
    <text class="body-sm ink" x="{{ s(40) }}" y="{{ s(160 + loop.index0 * 70) }}">{{ line }}</text>
    {% endfor %}
  </g>

  {# Row 2: LENS | ANGLE #}
  {% set p2_top = p_top + p_h + p_gap %}
  <g transform="translate({{ s(rx) }}, {{ s(p2_top) }})">
    <rect class="panel-bg" width="{{ s(p_w) }}" height="{{ s(p_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(80) }}">LENS</text>
    <text class="body ink" x="{{ s(40) }}" y="{{ s(170) }}">{{ pose.camera_notes.lens }}</text>
    <text class="body-sm muted" x="{{ s(40) }}" y="{{ s(250) }}">{{ pose.camera_notes.aperture }}</text>
  </g>
  <g transform="translate({{ s(rx + p_w + p_gap) }}, {{ s(p2_top) }})">
    <rect class="panel-bg" width="{{ s(p_w) }}" height="{{ s(p_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(80) }}">CAMERA</text>
    <text class="body ink" x="{{ s(40) }}" y="{{ s(170) }}">{{ pose.camera_notes.angle }}</text>
    <text class="body-sm muted" x="{{ s(40) }}" y="{{ s(250) }}">{{ pose.camera_notes.distance }}</text>
  </g>

  {# SAY TO COUPLE — blue hero panel, full right-column width #}
  {% set say_top = p2_top + p_h + p_gap %}
  {% set say_h = 380 %}
  <g transform="translate({{ s(rx) }}, {{ s(say_top) }})">
    <rect class="panel-cue" width="{{ s(rw) }}" height="{{ s(say_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-blue" x="{{ s(40) }}" y="{{ s(80) }}">SAY TO THE COUPLE</text>
    {% for line in cue_lines[:3] %}
    <text class="cue ink" x="{{ s(40) }}" y="{{ s(170 + loop.index0 * 90) }}">"{{ line }}"</text>
    {% endfor %}
  </g>

  {# TIP panel (only if variations) — orange #}
  {% if pose.variations %}
  {% set tip_top = say_top + say_h + p_gap %}
  <g transform="translate({{ s(rx) }}, {{ s(tip_top) }})">
    <rect class="panel-tip" width="{{ s(rw) }}" height="{{ s(220) }}" rx="{{ s(8) }}"/>
    <text class="label label-orange" x="{{ s(40) }}" y="{{ s(80) }}">TIP</text>
    <text class="body ink" x="{{ s(40) }}" y="{{ s(160) }}">{{ pose.variations[0] }}</text>
  </g>
  {% endif %}

  {# Bottom-right version stamp #}
  <text class="footer muted" x="{{ width - s(80) }}" y="{{ height - s(60) }}" text-anchor="end">v{{ pose.version }}.0</text>
</svg>
