{# Dark, info-dense pose card. Illustration top, panels bottom. #}
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}">
  <defs>
    <style>
      .bg          { fill: #0E1420; }
      .panel-bg    { fill: #1A2330; }
      .panel-cue   { fill: #1E3A5F; }
      .panel-bonus { fill: #5A2E1A; }
      .border      { fill: none; stroke: #2A3540; stroke-width: 2; }
      .ink         { fill: #FFFFFF; }
      .muted       { fill: #A8B0BD; }
      .label-gold  { fill: #E0A93E; }
      .label-blue  { fill: #7DB3E8; }
      .label-orange{ fill: #E8A040; }

      .id-badge    { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(34) }}px; letter-spacing: 6px; }
      .pack-badge  { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(28) }}px; letter-spacing: 8px; }
      .h1          { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(96) }}px; }
      .subtitle    { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(36) }}px; }
      .label       { font-family: 'Helvetica','Arial',sans-serif; font-weight: 800; font-size: {{ s(32) }}px; letter-spacing: 6px; }
      .body        { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(36) }}px; }
      .body-sm     { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(30) }}px; }
      .cue         { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(56) }}px; font-style: italic; }
      .footer      { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(24) }}px; letter-spacing: 4px; }
    </style>
  </defs>

  <rect class="bg" width="100%" height="100%"/>

  {# Top corner badges #}
  <text class="pack-badge label-gold" x="{{ s(80) }}" y="{{ s(80) }}">{{ pose.pack|upper }}</text>
  <text class="id-badge muted" x="{{ width - s(80) }}" y="{{ s(80) }}" text-anchor="end">{{ pose.id|upper }}</text>

  {# Illustration zone - centered in top half, white strokes on dark via currentColor #}
  <g transform="translate({{ s(400) }}, {{ s(140) }})" color="#FFFFFF">
    <svg width="{{ s(3200) }}" height="{{ s(1100) }}" viewBox="{{ illustration_viewbox }}" preserveAspectRatio="xMidYMid meet">
      {{ illustration_svg|safe }}
    </svg>
  </g>

  {# Title strip #}
  <g transform="translate({{ s(80) }}, {{ s(1380) }})">
    <text class="h1 ink">{{ pose.title }}</text>
    {% if pose.tags %}
    <text class="subtitle muted" y="{{ s(50) }}">{{ pose.tags|join(' · ') }}</text>
    {% endif %}
  </g>

  {# HER / HIM two-column panels #}
  {% set panel_top = 1540 %}
  {% set panel_h = 380 %}
  {% set panel_gap = 30 %}
  {% set col_w = (4000 - 80*2 - panel_gap) / 2 %}

  <g transform="translate({{ s(80) }}, {{ s(panel_top) }})">
    <rect class="panel-bg" width="{{ s(col_w) }}" height="{{ s(panel_h) }}" rx="{{ s(8) }}"/>
    <rect class="border"   width="{{ s(col_w) }}" height="{{ s(panel_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(70) }}">HER</text>
    {% for line in pose.positioning.her %}
    <text class="body ink" x="{{ s(40) }}" y="{{ s(140 + loop.index0 * 60) }}">· {{ line }}</text>
    {% endfor %}
  </g>

  <g transform="translate({{ s(80 + col_w + panel_gap) }}, {{ s(panel_top) }})">
    <rect class="panel-bg" width="{{ s(col_w) }}" height="{{ s(panel_h) }}" rx="{{ s(8) }}"/>
    <rect class="border"   width="{{ s(col_w) }}" height="{{ s(panel_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(70) }}">HIM</text>
    {% for line in pose.positioning.him %}
    <text class="body ink" x="{{ s(40) }}" y="{{ s(140 + loop.index0 * 60) }}">· {{ line }}</text>
    {% endfor %}
  </g>

  {# CAMERA panel - full width #}
  {% set camera_top = panel_top + panel_h + panel_gap %}
  <g transform="translate({{ s(80) }}, {{ s(camera_top) }})">
    <rect class="panel-bg" width="{{ s(3840) }}" height="{{ s(220) }}" rx="{{ s(8) }}"/>
    <rect class="border"   width="{{ s(3840) }}" height="{{ s(220) }}" rx="{{ s(8) }}"/>
    <text class="label label-gold" x="{{ s(40) }}" y="{{ s(70) }}">CAMERA</text>
    <text class="body ink" x="{{ s(40) }}" y="{{ s(140) }}">{{ pose.camera_notes.lens }} · {{ pose.camera_notes.aperture }} · {{ pose.camera_notes.angle }}</text>
    <text class="body-sm muted" x="{{ s(40) }}" y="{{ s(190) }}">{{ pose.camera_notes.distance }}{% if pose.camera_notes.notes %} · {{ pose.camera_notes.notes }}{% endif %}</text>
  </g>

  {# SAY TO THE COUPLE - blue hero panel #}
  {% set cue_top = camera_top + 220 + panel_gap %}
  {% set cue_h = height/s(1) - cue_top - 120 %}
  <g transform="translate({{ s(80) }}, {{ s(cue_top) }})">
    <rect class="panel-cue" width="{{ s(3840) }}" height="{{ s(cue_h) }}" rx="{{ s(8) }}"/>
    <text class="label label-blue" x="{{ s(40) }}" y="{{ s(70) }}">SAY TO THE COUPLE</text>
    {% for line in cue_lines %}
    <text class="cue ink" x="{{ s(40) }}" y="{{ s(150 + loop.index0 * 80) }}">"{{ line }}"</text>
    {% endfor %}
  </g>

  {# Footer strip #}
  <text class="footer muted" x="{{ s(80) }}" y="{{ height - s(40) }}">DIFFICULTY {{ '●' * pose.difficulty }}{{ '○' * (3 - pose.difficulty) }}  ·  v{{ pose.version }}</text>
  <text class="footer muted" x="{{ width - s(80) }}" y="{{ height - s(40) }}" text-anchor="end">posingincam</text>
</svg>
