{# Default landscape pose card. Variables bound from posingincam.render.layout. #}
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}">
  <defs>
    <style>
      .bg     { fill: #ffffff; }
      .ink    { fill: #111111; }
      .muted  { fill: #555555; }
      .accent { fill: #b14a2e; }
      .rule   { stroke: #cccccc; stroke-width: 2; }
      .h1     { font-family: 'Georgia','Times New Roman',serif; font-weight: 700; font-size: {{ s(56) }}px; }
      .id     { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(28) }}px; letter-spacing: 4px; }
      .label  { font-family: 'Helvetica','Arial',sans-serif; font-weight: 700; font-size: {{ s(26) }}px; letter-spacing: 6px; }
      .body   { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(28) }}px; }
      .body-sm{ font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(24) }}px; }
      .cue    { font-family: 'Georgia','Times New Roman',serif; font-style: italic; font-weight: 400; font-size: {{ s(40) }}px; }
      .footer { font-family: 'Helvetica','Arial',sans-serif; font-weight: 400; font-size: {{ s(20) }}px; fill: #888888; letter-spacing: 2px; }
    </style>
  </defs>

  <rect class="bg" width="100%" height="100%"/>

  {# Header band: title + id #}
  <g transform="translate({{ s(80) }}, {{ s(110) }})">
    <text class="id muted">{{ pose.id|upper }}</text>
    <text class="h1 ink" y="{{ s(70) }}">{{ pose.title }}</text>
  </g>
  <line class="rule" x1="{{ s(80) }}" y1="{{ s(220) }}" x2="{{ width - s(80) }}" y2="{{ s(220) }}"/>

  {# Illustration zone (left half) #}
  <g transform="translate({{ s(80) }}, {{ s(260) }})">
    <svg width="{{ s(1500) }}" height="{{ s(1100) }}" viewBox="{{ illustration_viewbox }}" preserveAspectRatio="xMidYMid meet">
      {{ illustration_svg|safe }}
    </svg>
  </g>

  {# Right column: positioning + camera notes + cue #}
  <g transform="translate({{ s(1700) }}, {{ s(280) }})">

    <text class="label accent">HER</text>
    {% for line in pose.positioning.her %}
    <text class="body ink" y="{{ s(60 + loop.index0 * 56) }}">• {{ line }}</text>
    {% endfor %}

    <g transform="translate(0, {{ s(60 + (pose.positioning.her|length) * 56 + 40) }})">
      <text class="label accent">HIM</text>
      {% for line in pose.positioning.him %}
      <text class="body ink" y="{{ s(60 + loop.index0 * 56) }}">• {{ line }}</text>
      {% endfor %}
    </g>

    <g transform="translate(0, {{ s(60 + (pose.positioning.her|length + pose.positioning.him|length) * 56 + 160) }})">
      <text class="label accent">CAMERA</text>
      <text class="body ink"   y="{{ s(60) }}">{{ pose.camera_notes.lens }}  ·  {{ pose.camera_notes.aperture }}</text>
      <text class="body-sm muted" y="{{ s(110) }}">{{ pose.camera_notes.angle }}</text>
      <text class="body-sm muted" y="{{ s(150) }}">{{ pose.camera_notes.distance }}</text>
      {% if pose.camera_notes.notes %}
      <text class="body-sm muted" y="{{ s(190) }}">{{ pose.camera_notes.notes }}</text>
      {% endif %}
    </g>
  </g>

  {# Bottom band: verbal cue, full width #}
  <line class="rule" x1="{{ s(80) }}" y1="{{ height - s(380) }}" x2="{{ width - s(80) }}" y2="{{ height - s(380) }}"/>
  <g transform="translate({{ s(80) }}, {{ height - s(310) }})">
    <text class="label accent">SAY TO THE COUPLE</text>
    {% for line in cue_lines %}
    <text class="cue ink" y="{{ s(50 + loop.index0 * 60) }}">{{ line }}</text>
    {% endfor %}
  </g>

  {# Footer #}
  <text class="footer" x="{{ s(80) }}" y="{{ height - s(50) }}">{{ pose.pack|upper }}  ·  DIFFICULTY {{ '●' * pose.difficulty }}{{ '○' * (3 - pose.difficulty) }}  ·  v{{ pose.version }}</text>
  <text class="footer" x="{{ width - s(80) }}" y="{{ height - s(50) }}" text-anchor="end">posingincam</text>
</svg>
